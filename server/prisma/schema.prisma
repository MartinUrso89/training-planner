generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TipoArticular {
  Poliarticular
  Monoarticular
}

enum PatronMovimiento {
  Empuje
  Traccion
  DominanteRodilla
  DominanteCadera
  Rotacion
  Antirrotacion
  Flexion
  Extension
}

enum EstadoSugerencia {
  Pendiente
  Aprobado
  Rechazado
}

model Usuario {
  id                    String               @id @default(uuid())
  nombre                String
  correo                String               @unique
  contrasena            String
  creadoEn              DateTime             @default(now())
  tokensRefresco        TokenRefresco[]
  plantillasPlan        PlantillaPlan[]
  entrenamientos        Entrenamiento[]      @relation("EntrenamientosAsignados")
  entrenamientosCreados Entrenamiento[]      @relation("EntrenamientosCreadosPor")
}

model TokenRefresco {
  token     String   @id
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  creadoEn  DateTime @default(now())

  @@unique([token, usuarioId])
}

model TipoSeccion {
  id                        String                   @id
  nombre                    String                   @unique
  seccionesPlantilla        SeccionPlantilla[]
  seccionesEntrenamiento    SeccionEntrenamiento[]
}

model Ejercicio {
  id                      String                    @id @default(uuid())
  nombre                  String
  musculoPrincipal        String
  musculoSecundario       String?
  tipoArticular           TipoArticular
  patronMovimiento        PatronMovimiento
  videoUrl                String?
  descripcion             String?
  creadoPor               String
  creadoEn                DateTime                  @default(now())
  ejerciciosPlantilla     EjercicioPlantilla[]
  ejerciciosEntrenamiento EjercicioEntrenamiento[]
}

model PlantillaPlan {
  id            String             @id @default(uuid())
  nombre        String
  descripcion   String?
  usuarioId     String
  usuario       Usuario            @relation(fields: [usuarioId], references: [id])
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
  secciones     SeccionPlantilla[]
  entrenamientos Entrenamiento[]
}

model SeccionPlantilla {
  id                      String                @id @default(uuid())
  plantillaId             String
  tipoSeccionId           String
  nombre                  String?
  orden                   Int
  rondas                  Int?
  tiempoLimite            Int?
  descansoEntreEjercicios Int?
  descansoEntreRondas     Int?
  plantilla               PlantillaPlan         @relation(fields: [plantillaId], references: [id], onDelete: Cascade)
  tipoSeccion             TipoSeccion           @relation(fields: [tipoSeccionId], references: [id])
  ejercicios              EjercicioPlantilla[]
}

model EjercicioPlantilla {
  id                 String             @id @default(uuid())
  seccionPlantillaId String
  ejercicioId        String
  orden              Int
  series             Int?
  repeticiones       Int?
  duracionSegundos   Int?
  peso               Float?
  rpe                Float?
  descansoEntreSeries Int?
  grupoSuperserieId   String?
  ordenSuperserie     Int?
  notas              String?
  seccion            SeccionPlantilla    @relation(fields: [seccionPlantillaId], references: [id], onDelete: Cascade)
  ejercicio          Ejercicio           @relation(fields: [ejercicioId], references: [id])
}

model Entrenamiento {
  id            String               @id @default(uuid())
  plantillaId   String?
  plantilla     PlantillaPlan?       @relation(fields: [plantillaId], references: [id])
  usuarioId     String
  usuario       Usuario              @relation("EntrenamientosAsignados", fields: [usuarioId], references: [id])
  asignadoPorId String
  asignadoPor   Usuario              @relation("EntrenamientosCreadosPor", fields: [asignadoPorId], references: [id])
  fecha         DateTime
  completado    Boolean              @default(false)
  completadoEn  DateTime?
  creadoEn      DateTime             @default(now())
  secciones     SeccionEntrenamiento[]
}

model SeccionEntrenamiento {
  id                      String                @id @default(uuid())
  entrenamientoId         String
  tipoSeccionId           String
  nombre                  String?
  orden                   Int
  rondas                  Int?
  tiempoLimite            Int?
  descansoEntreEjercicios Int?
  descansoEntreRondas     Int?
  entrenamiento           Entrenamiento         @relation(fields: [entrenamientoId], references: [id], onDelete: Cascade)
  tipoSeccion             TipoSeccion           @relation(fields: [tipoSeccionId], references: [id])
  ejercicios              EjercicioEntrenamiento[]
}

model EjercicioEntrenamiento {
  id                       String                @id @default(uuid())
  seccionEntrenamientoId   String
  ejercicioId              String
  orden                    Int
  seriesPrevistas          Int?
  repeticionesPrevistas    Int?
  duracionPrevista         Int?
  pesoPrevisto             Float?
  rpePrevisto              Float?
  descansoPrevisto         Int?
  grupoSuperserieId         String?
  ordenSuperserie           Int?
  notas                    String?
  seccion                  SeccionEntrenamiento   @relation(fields: [seccionEntrenamientoId], references: [id], onDelete: Cascade)
  ejercicio                Ejercicio              @relation(fields: [ejercicioId], references: [id])
  registros                RegistroEjercicio[]
}

model RegistroEjercicio {
  id                       String                @id @default(uuid())
  ejercicioEntrenamientoId String
  completado               Boolean               @default(false)
  repeticionesReales       Int?
  pesoReal                 Float?
  rpeReal                  Float?
  duracionReal             Int?
  comentario               String?
  completadoEn             DateTime?
  ejercicio                EjercicioEntrenamiento @relation(fields: [ejercicioEntrenamientoId], references: [id], onDelete: Cascade)
}

model SugerenciaEjercicio {
  id                String             @id @default(uuid())
  nombre            String
  musculoPrincipal  String
  musculoSecundario String?
  tipoArticular     TipoArticular
  patronMovimiento  PatronMovimiento
  videoUrl          String?
  descripcion       String?
  sugeridoPor       String
  sugeridoEn        DateTime           @default(now())
  estado            EstadoSugerencia   @default(Pendiente)
  revisadoPor       String?
  revisadoEn        DateTime?
  comentarioRechazo String?
}
