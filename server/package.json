{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:push": "tsx scripts/db-test-push.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "~5.22.0",
    "bcrypt": "~5.1.1",
    "cors": "~2.8.6",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "jsonwebtoken": "~9.0.2",
    "morgan": "~1.10.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.4",
    "@types/bcrypt": "~5.0.2",
    "@types/cors": "~2.8.17",
    "@types/express": "~5.0.0",
    "@types/jsonwebtoken": "~9.0.9",
    "@types/morgan": "~1.9.10",
    "@types/node": "~22.0.0",
    "@types/supertest": "~6.0.2",
    "@vitest/coverage-v8": "~4.1.4",
    "cross-env": "~10.1.0",
    "eslint": "~9.0.0",
    "prisma": "~5.22.0",
    "supertest": "~7.2.2",
    "tsx": "~4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "~8.33.0",
    "vitest": "~4.1.4"
  }
}
